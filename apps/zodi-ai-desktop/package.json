{
  "name": "zodi-ai-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Windows and Linux launchers for the shared Zodi AI web application.",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "electron": "29.4.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "fr.zodi.ai.desktop",
    "productName": "Zodi AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "artifactName": "Zodi-AI-${version}-${arch}.${ext}"
    }
  }
}
